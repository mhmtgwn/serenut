# Serenut OS — Server Environment Variables
# Bu dosya şablondur. Gerçek değerler .env.production dosyasında olmalı.
# .env.production asla Git'e commit edilmemeli.
#
# Güçlü sır üretmek için:
#   openssl rand -hex 64   → JWT_SECRET için
#   openssl rand -hex 32   → diğer sırlar için

# ── SUNUCU ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://serenut.com
LEGAL_DOCUMENT_VERSION=2026-08-09
# Salt-okunur satış öncesi denetim için açıkça verilir; uygulama başlatmak için kullanılmaz.
PRODUCTION_DATABASE_URL=postgresql://serenut_auditor:READ_ONLY_PASSWORD@127.0.0.1:5432/serenut_db

# Şahıs işletmesi / fatura bilgi formu. SELLER_TAX_NUMBER kaynak koda yazılmaz.
SELLER_LEGAL_NAME=Mehmet Güven
SELLER_ADDRESS_LINE_1=Mustafa Güven Caddesi No: 6
SELLER_ADDRESS_LINE_2=Ormanlı Merkez, Karadeniz Ereğli/Zonguldak
SELLER_TAX_OFFICE=Ereğli Vergi Dairesi
SELLER_TAX_NUMBER=SET_IN_SECRET_MANAGER
SELLER_CONTACT=0538 028 82 02
INVOICE_DOCUMENT_LABEL=FATURA BİLGİ FORMU

# ── VERİTABANI ────────────────────────────────────────────────────────────────
# UYARI: Varsayılan şifre kullanmayın. Güçlü bir şifre oluşturun.
DATABASE_URL=postgresql://serenut_user:STRONG_DB_PASSWORD_HERE@127.0.0.1:5432/serenut_db
POSTGRES_USER=serenut_user
POSTGRES_PASSWORD=STRONG_DB_PASSWORD_HERE
POSTGRES_DB=serenut_db

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:STRONG_REDIS_PASSWORD_HERE@127.0.0.1:6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# ── JWT / KİMLİK DOĞRULAMA ───────────────────────────────────────────────────
# ZORUNLU: En az 32 karakter. Üretim için 64 hex karakter önerilir.
# Eksik veya kısa olması durumunda sunucu BAŞLAMAZ.
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_64_OUTPUT

# ── LİSANS İMZALAMA / RSA KEY PAIR ──────────────────────────────────────────
# ZORUNLU: Lisans imzalama için 2048-bit RSA Private Key (Sunucuda bulunur)
# Format: Tek satır PEM veya JSON JWK formatında string
# Mandatory for license signing. Never commit the matching private key.
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RELEASE_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── YEDEKLEME ─────────────────────────────────────────────────────────────────
BACKUP_PASSPHRASE=STRONG_BACKUP_ENCRYPTION_PASSWORD
S3_BUCKET=serenut-backups
S3_REGION=eu-central-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
DB_HOST=127.0.0.1
DB_USER=serenut_user
DB_NAME=serenut_db

# ── E-POSTA (VPS SMTP; Postmark API anahtarı isteğe bağlı yedek) ─────────────
SMTP_HOST=mail.serenut.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@serenut.com
SMTP_PASSWORD=STRONG_SMTP_PASSWORD_HERE
SMTP_FROM_EMAIL=noreply@serenut.com
SMTP_FROM_NAME=Serenut
# SMTP_API_KEY=YOUR_POSTMARK_API_KEY

# ── SMS (Netgsm / Twilio) ─────────────────────────────────────────────────────
SMS_PROVIDER=netgsm
SMS_API_KEY=YOUR_NETGSM_API_KEY
SMS_API_SECRET=YOUR_NETGSM_API_SECRET
SMS_SENDER_ID=SERENUT

# ── WHATSAPP BUSINESS PLATFORM (Meta Cloud API) ─────────────────────────────
# Meta Developer uygulaması ve Embedded Signup yapılandırmasından alınır.
META_APP_ID=1224880033182854
META_APP_SECRET=SET_IN_SECRET_MANAGER
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=2051947882108806
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
# Müşteri erişim belirteçlerini AES-256-GCM ile şifrelemek için ayrı sır.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=90
# Meta webhook URL: https://serenut.com/api/v1/whatsapp/webhook
# App Review ve üretim sağlayıcısı hazır olmadan whatsapp kanalını eklemeyin.
NOTIFICATION_ENABLED_CHANNELS=sms,email

# ── ÖDEME GEÇİDİ (İyzico) ───────────────────────────────────────────────────
IYZICO_ENABLED=false

# ── ÖDEME GEÇİDİ (Stripe — alternatif) ─────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Geçici olarak false yapıldığında yeni ve mevcut doğrulanmamış hesaplar giriş yapabilir.
REQUIRE_EMAIL_VERIFICATION=false
# SMTP/Postmark kullanıma hazır olana kadar false bırakın.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=SET_IN_SECRET_MANAGER
RESEND_WEBHOOK_SECRET=SET_AFTER_WEBHOOK_CREATION

# Public origin used in permanent company logo URLs (no trailing slash).
PUBLIC_BASE_URL=https://api.example.com
# Persistent VPS path; mount and back up this directory in production.
COMPANY_LOGOS_DIR=/var/lib/serenut/company-logos
