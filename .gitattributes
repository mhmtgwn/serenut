# Auto detect text files and perform LF normalization on checkout and commit
* text=auto eol=lf

# Windows specific scripts and installer configs
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.cer binary
*.pfx binary
*.db binary
*.sqlite binary
