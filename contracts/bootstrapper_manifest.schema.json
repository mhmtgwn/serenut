{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://serenut.com/schemas/bootstrapper_manifest.schema.json",
  "title": "BootstrapperManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "correlationId",
    "appPid",
    "targetVersion",
    "installerPath",
    "targetDir",
    "backupDir",
    "postLaunchExe"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "appPid": {
      "type": "integer",
      "minimum": 1
    },
    "targetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(\\+[0-9]+)?$"
    },
    "installerPath": {
      "type": "string",
      "minLength": 1
    },
    "targetDir": {
      "type": "string",
      "minLength": 1
    },
    "backupDir": {
      "type": "string",
      "minLength": 1
    },
    "postLaunchExe": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
